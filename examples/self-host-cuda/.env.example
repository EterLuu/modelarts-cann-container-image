SELF_HOST_IMAGE=self-host-cuda:12.8.1-ubuntu24.04
CONTAINER_NAME=self-host-cuda
CONTAINER_HOSTNAME=self-host-cuda

# Used only on the first initialization. Remove it after the first successful start.
INITIAL_ROOT_PASSWORD=
INITIAL_ROOT_PASSWORD_FILE=
INITIAL_ROOT_PASSWORD_PATH=./root-password

# Optional alternative to password login.
SSH_PUBLIC_KEY=
SSH_AUTHORIZED_KEYS_FILE=
SSH_AUTHORIZED_KEYS_PATH=./authorized_keys

SSH_HOST_PORT=2222
JUPYTER_HOST_PORT=8888
TENSORBOARD_HOST_PORT=6006

CPU_LIMIT=16
MEMORY_LIMIT=64g
PIDS_LIMIT=4096
SHM_SIZE=16gb
GPU_COUNT=all
NVIDIA_VISIBLE_DEVICES=all

PROJECTS_DIR=./projects
DATA_DIR=./data
TZ=Asia/Shanghai
